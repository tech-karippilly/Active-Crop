<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Active Crop | Sign Up Page</title>
  <link rel="shortcut icon" href="../../../public/asstes/images/logo.jpg" type="image/x-icon">

  <link rel="stylesheet" href="../../../public/styles/userAuthStyle.css">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
</head>

<body>

  <div class="alert-box " id="alert-box">
    <% if (alertMessage) { %>
      <% if (typeof alertMessage==='string' ) { %>
        <div class="alert alert-<%= alertType %>" id="alert">
          <%= alertMessage %>
        </div>
        <% } else { %>
          <% Object.entries(alertMessage).forEach(([key, message])=> { %>
            <div class="alert alert-<%= alertType %>" id="alert">
              <%= message %>
            </div>
            <% }) %>
              <% } %>
                <% } %>
  </div>

  <section class="login-form-section">
    <div class="card">
      <img src="../../../public/asstes/images/logo.jpg" class="card-image" alt="logo">
      <div class="card-body">
        <h5 class="card-title text-center">Create Account</h5>

        <form id="signup-form" method="post" action="/auth/signup">

          <div class="row">
            <div class="col">
              <label for="firstName" class="form-label lable-text">First Name</label>
              <input type="text" class="form-control" name="firstName" id="firstName">
              <span class="error-message"></span>
            </div>
            <div class="col">
              <label for="lastName" class="form-label lable-text">Last Name</label>
              <input type="text" class="form-control" name="lastName" id="lastName">
              <span class="error-message"></span>
            </div>
          </div>
        
          <div class="mb-3">
            <label for="userName" class="form-label lable-text">User Name</label>
            <input type="text" class="form-control" name="userName" id="userName">
            <span class="error-message"></span>
          </div>
        
          <div class="row">
            <div class="col">
              <label for="phone" class="form-label lable-text">Phone</label>
              <input type="text" class="form-control" name="phone" id="phone">
              <span class="error-message"></span>
            </div>
            <div class="col">
              <label for="email" class="form-label lable-text">Email address</label>
              <input type="email" class="form-control" name="email" id="exampleInputEmail1" aria-describedby="emailHelp">
              <span class="error-message"></span>
            </div>
          </div>
        
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label lable-text">Password</label>
            <input type="password" class="form-control" name="password" id="exampleInputPassword1">
            <span class="error-message"></span>
          </div>
        
          <div class="mb-3">
            <label for="confirmPassword" class="form-label lable-text">Confirm Password</label>
            <input type="password" class="form-control" name="confirmPassword" id="confirmPassword">
            <span class="error-message"></span>
          </div>
        
          <input type="hidden" id="referal" name="referal">
        
          <div class="btn-contianer mb-3">
            <button type="submit" class="btn">Create Account</button>
          </div>
          
          <div class="btn-contianer mb-3">
            <a class="link" href="/auth/login">Already have an account?</a>
          </div>
        
        </form>
        
      </div>
    </div>

  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const form = document.getElementById('signup-form');

form.addEventListener('submit', function (event) {
  event.preventDefault(); // Prevent form submission initially
  
  const firstName = document.getElementById('firstName');
  const lastName = document.getElementById('lastName');
  const userName = document.getElementById('userName');
  const phone = document.getElementById('phone');
  const email = document.getElementById('exampleInputEmail1');
  const password = document.getElementById('exampleInputPassword1');
  const confirmPassword = document.getElementById('confirmPassword');

  let errors = [];
  
  function showError(input, message) {
    const errorSpan = input.nextElementSibling;
    errorSpan.innerText = message;
    errorSpan.style.color = 'red';
  }
  
  function clearErrors() {
    document.querySelectorAll('.error-message').forEach(span => span.innerText = '');
  }

  clearErrors();

  if (!firstName.value.trim()) {
    errors.push('First Name is required.');
    showError(firstName, 'First Name is required.');
  }
  if (!lastName.value.trim()) {
    errors.push('Last Name is required.');
    showError(lastName, 'Last Name is required.');
  }
  if (!userName.value.trim()) {
    errors.push('User Name is required.');
    showError(userName, 'User Name is required.');
  }
  if (!phone.value.trim().match(/^\d{10}$/)) {
    errors.push('Enter a valid 10-digit phone number.');
    showError(phone, 'Enter a valid 10-digit phone number.');
  }
  if (!email.value.trim().match(/^\S+@\S+\.\S+$/)) {
    errors.push('Enter a valid email address.');
    showError(email, 'Enter a valid email address.');
  }
  if (password.value.length < 6) {
    errors.push('Password must be at least 6 characters long.');
    showError(password, 'Password must be at least 6 characters long.');
  }
  if (password.value !== confirmPassword.value) {
    errors.push('Passwords do not match.');
    showError(confirmPassword, 'Passwords do not match.');
  }
  
  if (errors.length > 0) {
    return;
  }
  
  form.submit(); // Submit the form if all validations pass
});


      const referalInput = document.getElementById('referal');
      const urlParams = new URLSearchParams(window.location.search);
      const referalCode = urlParams.get('referalCode');
      if (referalCode) {
        referalInput.value = referalCode;
      }
    })
    const alertBox = document.getElementById('alert-box')
    setTimeout(() => {
      alertBox.classList = '';
      alertBox.innerHTML = '';
    }, 3000);

    const redirectUrl = "<%= redirectUrl %>";
    if (redirectUrl && redirectUrl.trim() !== "") {
      setTimeout(() => {
        const userName = "<%= userName %>";
        window.localStorage.setItem('userName', userName)
        window.location.href = redirectUrl;
      }, 2000)

    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
    integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
    crossorigin="anonymous"></script>
</body>

</html>