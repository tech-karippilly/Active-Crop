<div class="w-1/6 h-[calc(100vh-4rem)] bg-gray-200 flex flex-col justify-between p-4">
  <!-- Navigation -->
  <ul class="space-y-4">
    <li class="relative p-2 text-lg font-medium 
        <%= activePage === 'Dashboard' ? 'text-green-600 font-bold' : 'text-gray-700' %>">
      <a href="/admin">Dashboard</a>
      <% if (activePage==='Dashboard' ) { %>
        <span class="absolute left-0 bottom-0 w-full h-1 bg-green-500"></span>
        <% } %>
    </li>

    <li class="relative p-2 text-lg font-medium 
        <%= activePage === 'Catagoery' ? 'text-green-600 font-bold' : 'text-gray-700' %>">
      <a href="/admin/category/category-list-page">Catagoery</a>
      <% if (activePage==='Catagoery' ) { %>
        <span class="absolute left-0 bottom-0 w-full h-1 bg-green-500"></span>
        <% } %>
    </li>

    <li class="relative p-2 text-lg font-medium 
        <%= activePage === 'reports' ? 'text-green-600 font-bold' : 'text-gray-700' %>">
      <a href="/reports">Reports</a>
      <% if (activePage==='reports' ) { %>
        <span class="absolute left-0 bottom-0 w-full h-1 bg-green-500"></span>
        <% } %>
    </li>
  </ul>

  <!-- Logout Button -->
  <a href="/logout" class="bg-green-500 text-white font-semibold py-2 px-4 rounded text-center">
    Logout
  </a>
</div>
<script>
  function setActive(element) {
    // Remove active class from all li elements
    document.querySelectorAll("li").forEach(li => {
      li.classList.remove("text-green-600", "font-bold");
      li.querySelector("span").classList.add("hidden");
    });

    // Add active class to clicked li
    element.classList.add("text-green-600", "font-bold");
    element.querySelector("span").classList.remove("hidden");
  }

  function handleLogout() {
    fetch('/admin/auth/logout', {
      method: 'GET',
    })
      .then(response => response.json())
      .then(data => {
        showMessage(data.message, data.type)
        if (data.redirect) {
          window.location.href = data.redirect
        }
      })
      .catch(error => console.error('Error:', error));
  }

  function showMessage(message, type) {
    const alertBox = document.createElement('div');
    alertBox.id = 'alertBox';
    alertBox.className = `absolute right-5 top-5 p-4 mb-4 text-sm font-medium border rounded-lg shadow-md transition-opacity duration-500 ease-out opacity-100
        ${type === 'success' ? 'bg-green-100 text-green-800 border-green-300' : ''}
        ${type === 'error' ? 'bg-red-100 text-red-800 border-red-300' : ''}
        ${type === 'warning' ? 'bg-yellow-100 text-yellow-800 border-yellow-300' : ''}
        ${type === 'info' ? 'bg-blue-100 text-blue-800 border-blue-300' : ''}`;
    alertBox.innerText = message;

    document.body.appendChild(alertBox);

    setTimeout(() => {
      alertBox.classList.add("opacity-0");
      setTimeout(() => alertBox.remove(), 500);
    }, 2000);
  }
</script>